# =============================================================================
# SmartResolve AI — repository ignore rules
#
# One root file covers all three services (client/, server/, ml-service/).
# Service-specific .gitignore files are not needed: the "**/" patterns below
# match at any depth.
#
# Rule order matters — the LAST matching pattern wins. Negations for files that
# MUST be committed are collected at the bottom of this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js dependencies
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz

# -----------------------------------------------------------------------------
# Python dependencies and virtual environments
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/wheels/
pip-wheel-metadata/

.venv/
venv/
env/
ENV/
**/.venv/
**/venv/
**/env/

# -----------------------------------------------------------------------------
# Environment files and secrets
#   Only *.env.example templates (placeholders only) are tracked.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Local env tooling / dotenv secrets
.envrc
.direnv/

# Private key material — never belongs in the repository
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*

# -----------------------------------------------------------------------------
# Build output (regenerated by `npm run build` / `vite build`)
# -----------------------------------------------------------------------------
dist/
build/
client/dist/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Test, coverage and tool caches
# -----------------------------------------------------------------------------
coverage/
.coverage
.coverage.*
htmlcov/
.nyc_output/
.pytest_cache/
**/.pytest_cache/
.tox/
.nox/
.cache/
.eslintcache
.testmondata/

# Python tooling caches
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pip-log.txt

# -----------------------------------------------------------------------------
# ML model artifacts — GENERATED, not source
#   ml-service/artifacts/ is written by `python train.py` from the tracked
#   dataset in ml-service/data/. The README deployment table lists
#   `python train.py` as the ML service build step, so the artifact is
#   reproduced at deploy time instead of being committed (a joblib pickle is
#   tied to the scikit-learn version that produced it — requirements.txt
#   pins scikit-learn==1.8.0, so a rebuild is loadable by the deployed app).
#   The source of truth — ml-service/data/issues_dataset.csv — IS tracked.
# -----------------------------------------------------------------------------
ml-service/artifacts/

# -----------------------------------------------------------------------------
# Local database data (if ever checked into the repo)
# -----------------------------------------------------------------------------
mongo-data/

# -----------------------------------------------------------------------------
# Editors, IDE settings and OS files
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.bak
*.orig
*.rej

# -----------------------------------------------------------------------------
# Hosting platform local state (project links, auth tokens, CLI caches)
# -----------------------------------------------------------------------------
.vercel/
.netlify/
.render/
.wrangler/
.serverless/

# =============================================================================
# TRACKED ON PURPOSE — explicit re-inclusions (keep at the end of the file so
# they win over the broader patterns above).
# =============================================================================

# Safe environment templates containing placeholders only.
!.env.example
!**/.env.example

# The labeled training dataset. Required to rebuild the classifier at deploy
# time and to reproduce the reported held-out metrics.
!ml-service/data/
!ml-service/data/**

# Dependency manifests and lockfiles (deterministic, reviewable installs).
!**/package.json
!**/package-lock.json
!ml-service/requirements.txt

# Runtime scripts and seed data provisioning.
!server/scripts/
!server/scripts/**

# Model artifacts, if they are ever switched to a committed-artifact workflow:
# uncomment the next line to track the trained model instead of rebuilding it.
# !ml-service/artifacts/

# -----------------------------------------------------------------------------
# Local agent tooling — not part of the project source.
# Kept last so it wins over the !**/package.json re-inclusion above, otherwise
# a locally recreated .opencode/ would partially re-enter the repository.
# -----------------------------------------------------------------------------
.opencode/
